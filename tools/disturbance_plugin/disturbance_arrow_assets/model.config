<?xml version="1.0"?>
<model>
  <name>Disturbance Arrow Assets</name>
  <version>1.0</version>
  <sdf version="1.5">model.sdf</sdf>
  <description>
    Mesh assets used by disturbance_plugin to render arrow visuals.
    Not intended to be spawned directly; cone.stl is referenced via
    model://disturbance_arrow_assets/meshes/cone.stl from plugin-generated SDF.
  </description>
</model>
